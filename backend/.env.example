# =======================================================
# VARIABLES DE ENTORNO PARA DESPLIEGUE LOCAL Y EN LA NUBE
# =======================================================

# 1. Base de Datos MySQL (Local XAMPP o Cloud en Aiven / Railway)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/pos_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# 2. Credenciales y Configuración de AWS S3
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=nombre-de-tu-bucket-s3

# 3. Seguridad y CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://tu-frontend.vercel.app
PORT=8080
